# 從 LINE Developers Console 的 Messaging API 頁籤取得
LINE_CHANNEL_ACCESS_TOKEN=你的_channel_access_token
LINE_CHANNEL_SECRET=你的_channel_secret

# 從 Anthropic Console (console.anthropic.com) 取得
ANTHROPIC_API_KEY=你的_anthropic_api_key

# 可選，預設 claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# 可選，每個使用者保留的對話輪數，預設 10
MAX_HISTORY_TURNS=10

# --- 以下兩個是選用的，設定了才會把對話記錄存進 Google Drive ---
# 都不填的話，會自動退回記憶體版儲存（重啟服務會清空對話記錄）

# 整包 service account JSON 金鑰「內容」，不是檔案路徑
# 從 Google Cloud Console 下載 JSON 後，整份貼成一行（JSON 字串本身允許換行以 \n 表示即可）
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...", "...":"..."}

# 目標 Drive 資料夾 ID，從資料夾網址取得：
# https://drive.google.com/drive/folders/【這一段就是 folder id】
GOOGLE_DRIVE_FOLDER_ID=你的資料夾ID
